{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/*)",
      "Bash(uv *)",
      "PowerShell(uv *)",
      "mcp__unreal-mcp",
      "mcp__blender"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": [
    "unreal-mcp",
    "blender"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-binary-assets.ps1"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/require-build-on-stop.ps1"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "unreal-engine-skills-for-claude-code@claude-plugins-official": true
  }
}
